{
  "name": "axiom-pilot-code",
  "version": "1.0.0-alpha.1",
  "description": "Local-first coding agent with managed llama.cpp and LM Studio compatibility",
  "type": "module",
  "bin": {
    "pilotcode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/cli.js",
    "catalogs",
    "licenses",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node ./dist/cli.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:gpu": "npm run build && node scripts/gpu-smoke.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "local-ai",
    "coding-agent",
    "lm-studio",
    "cli",
    "llm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaoastronaftik-bit/axiom-pilot-code.git"
  },
  "homepage": "https://github.com/zaoastronaftik-bit/axiom-pilot-code#readme",
  "bugs": {
    "url": "https://github.com/zaoastronaftik-bit/axiom-pilot-code/issues"
  },
  "dependencies": {
    "ignore": "7.0.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/yauzl": "2.10.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
